PORT=3001
NODE_ENV=development

# MongoDB connection string (Replace with your own MongoDB URI or MongoDB Atlas URI)
MONGODB_URI=mongodb://localhost:27017/smartdrain

# Allowed device IDs (comma-separated)
ALLOWED_DEVICES=DRAIN_001,DRAIN_002,DRAIN_003

# Demo mode: set to true to enable /api/demo/simulate endpoint
DEMO_MODE=true
